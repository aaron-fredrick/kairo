flowchart TB
    %% ── C4 Level 4: Code – Application Layer ─────────────────────────────
    %% Files: app/application/services/*

    subgraph AppLayer["Application Layer  [app/application/services/]"]
        direction TB

        MsgSvc["message_service.py\nMessageService\n─────────────────────────────\n+ get_message(message_id, user_id) → MessageDomain\n+ send_message(content, sender_id, room_id) → MessageDomain\n+ delete_message(message_id, user_id) → None"]

        AttSvc["attachment_service.py\nAttachmentService\n─────────────────────────────\n+ get_attachments_for_message(message_id) → list[AttachmentDomain]"]

        PresSvc["presence_service.py\nPresenceService\n─────────────────────────────\n+ update_heartbeat(user_id) → datetime\n+ get_online_users(threshold_seconds) → list[int]"]
    end

    subgraph Domain["Domain Layer  [app/domain/]"]
        MsgDomain["MessageDomain\nmessage_domain.py"]
        AttDomain["AttachmentDomain\nattachment_domain.py"]
        MsgPolicy["MessagePolicy\nmessage_policy.py\ncan_delete(user_id, message)"]
    end

    subgraph Repos["Infrastructure – Repositories"]
        MsgRepo["MessageRepository\nmessage_repository.py"]
        AttRepo["AttachmentRepository\nattachment_repository.py"]
    end

    CacheMgr["Infrastructure – Cache\nCacheManager\nget/set presence heartbeats"]

    %% ── Flows ─────────────────────────────────────────────────────────────
    MsgSvc -->|"Injects & calls"| MsgRepo
    MsgSvc -->|"Injects & calls"| AttRepo
    MsgSvc -->|"Applies"| MsgPolicy
    MsgSvc -->|"Constructs"| MsgDomain

    AttSvc -->|"Injects & calls"| AttRepo
    AttSvc -->|"Constructs"| AttDomain

    PresSvc -->|"Reads/Writes"| CacheMgr

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef svc    fill:#1e1b4b,stroke:#7c3aed,color:#ddd6fe
    classDef dom    fill:#451a03,stroke:#c2410c,color:#fed7aa
    classDef infra  fill:#172554,stroke:#1d4ed8,color:#bfdbfe

    class MsgSvc,AttSvc,PresSvc svc
    class MsgDomain,AttDomain,MsgPolicy dom
    class MsgRepo,AttRepo,CacheMgr infra
