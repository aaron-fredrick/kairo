flowchart TB
    %% ── C4 Level 4: Code – Application Layer ─────────────────────────────
    %% Files: app/application/services/*

    subgraph AppLayer["Application Layer  [app/application/services/]"]
        direction TB

        MsgSvc["message_service.py<br/>MessageService<br/>─────────────────────────────<br/>+ get_message(message_id, user_id) → MessageDomain<br/>+ send_message(content, sender_id, room_id) → MessageDomain<br/>+ delete_message(message_id, user_id) → None"]

        AttSvc["attachment_service.py<br/>AttachmentService<br/>─────────────────────────────<br/>+ get_attachments_for_message(message_id) → list[AttachmentDomain]"]

        PresSvc["presence_service.py<br/>PresenceService<br/>─────────────────────────────<br/>+ update_heartbeat(user_id) → datetime<br/>+ get_online_users(threshold_seconds) → list[int]"]
    end

    subgraph Domain["Domain Layer  [app/domain/]"]
        MsgDomain["MessageDomain<br/>message_domain.py"]
        AttDomain["AttachmentDomain<br/>attachment_domain.py"]
        MsgPolicy["MessagePolicy<br/>message_policy.py<br/>can_delete(user_id, message)"]
    end

    subgraph Repos["Infrastructure – Repositories"]
        MsgRepo["MessageRepository<br/>message_repository.py"]
        AttRepo["AttachmentRepository<br/>attachment_repository.py"]
    end

    CacheMgr["Infrastructure – Cache<br/>CacheManager<br/>get/set presence heartbeats"]

    %% ── Flows ─────────────────────────────────────────────────────────────
    MsgSvc -->|"Injects & calls"| MsgRepo
    MsgSvc -->|"Injects & calls"| AttRepo
    MsgSvc -->|"Applies"| MsgPolicy
    MsgSvc -->|"Constructs"| MsgDomain

    AttSvc -->|"Injects & calls"| AttRepo
    AttSvc -->|"Constructs"| AttDomain

    PresSvc -->|"Reads/Writes"| CacheMgr

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef svc    fill:#1e1b4b,stroke:#7c3aed,color:#ddd6fe
    classDef dom    fill:#451a03,stroke:#c2410c,color:#fed7aa
    classDef infra  fill:#172554,stroke:#1d4ed8,color:#bfdbfe

    class MsgSvc,AttSvc,PresSvc svc
    class MsgDomain,AttDomain,MsgPolicy dom
    class MsgRepo,AttRepo,CacheMgr infra
