flowchart TB
    %% ── C4 Level 4: Code – Infrastructure Layer ──────────────────────────
    %% Files: app/infrastructure/db/*, app/infrastructure/repositories/*,
    %%        app/infrastructure/dtos/*, app/infrastructure/cache/*,
    %%        app/infrastructure/storage/*

    subgraph InfraLayer["Infrastructure Layer  [app/infrastructure/]"]
        direction TB

        subgraph DB["app/infrastructure/db/"]
            Base["base.py\nBase = declarative_base()\nShared SQLAlchemy metadata"]
            Session["session.py\nengine: AsyncEngine\nSessionFactory: async_sessionmaker\ncheck_db_connection() → None\nDialect-aware: sqlite or asyncpg"]

            subgraph ORM["app/infrastructure/db/orm/"]
                BaseORM["base_orm.py\nTimestampMixin\ncreated_at: DateTime\nupdated_at: DateTime"]
                UserORM["user_orm.py\nUserORM\nid, username, hashed_password,\nrole: UserRole, is_superadmin"]
                RoomORM["room_orm.py\nRoomORM\nid, name, created_by_id"]
                MsgORM["message_orm.py\nMessageORM\nid, content, sender_id, room_id\n→ attachments: AttachmentORM"]
                AttORM["attachment_orm.py\nAttachmentORM\nid, message_id, upload_id, filename"]
                UploadORM["upload_orm.py\nUploadORM\nid, filename, s3_key,\ncontent_type, size_bytes"]
                DMORM["direct_message_orm.py\nDirectMessageORM\nid, sender_id, receiver_id, content"]
            end
        end

        subgraph RepoLayer["app/infrastructure/repositories/"]
            BaseRepo["base_repository.py\nBaseRepository[ORM, DTO]\n─────────────────────────\nget_by_id(id) → DTO | None\nget_all() → list[DTO]\ncreate(data) → DTO\nupdate(id, data) → DTO | None\ndelete(id) → bool\n_to_dto() [abstract]"]
            MsgRepo["message_repository.py\nMessageRepository\n_to_dto() → MessageDTO\nget_with_attachments(id) → MessageDTO | None"]
            AttRepo["attachment_repository.py\nAttachmentRepository\n_to_dto() → AttachmentDTO\nget_by_message_id(id) → list[AttachmentDTO]"]
            RoomRepo["room_repository.py\nRoomRepository\n_to_dto() → RoomDTO"]
            UserRepo["user_repository.py\nUserRepository\n_to_dto() → UserDTO\nget_by_username(username) → UserDTO | None"]
        end

        subgraph DTOLayer["app/infrastructure/dtos/"]
            MsgDTO["message_dto.py\nMessageDTO\nid, content, sender_id,\nroom_id, created_at, updated_at"]
            AttDTO["attachment_dto.py\nAttachmentDTO\nid, message_id, upload_id,\nfilename, created_at, updated_at"]
            RoomDTO["room_dto.py\nRoomDTO\nid, name, created_at"]
            UserDTO["user_dto.py\nUserDTO\nid, username, role, created_at"]
        end

        subgraph CacheLayer["app/infrastructure/cache/"]
            CacheMgr["CacheManager\nget(key) → str | None\nset(key, value, ttl) → None\ndelete(key) → None\nkeys(pattern) → list[str]"]
        end

        subgraph StorageLayer["app/infrastructure/storage/"]
            StorageClient["storage_client.py\nget_boto_client() → boto3.client | None\ncheck_storage_connection() → None\ngenerate_presigned_url(key, expiry) → str"]
        end
    end

    %% ── External Systems ──────────────────────────────────────────────────
    PG[("PostgreSQL\nasyncpg driver")]
    SQLite[("SQLite\naiosqlite driver")]
    Redis[("Redis\naioredis")]
    S3[("S3 / MinIO\nboto3")]

    %% ── Flows ─────────────────────────────────────────────────────────────
    BaseORM --> Base

    UserORM & RoomORM & MsgORM & AttORM & UploadORM & DMORM --> BaseORM

    MsgRepo & AttRepo & RoomRepo & UserRepo --> BaseRepo
    MsgRepo -->|"Maps"| MsgORM
    MsgRepo -->|"Returns"| MsgDTO
    AttRepo -->|"Maps"| AttORM
    AttRepo -->|"Returns"| AttDTO
    RoomRepo -->|"Maps"| RoomORM
    RoomRepo -->|"Returns"| RoomDTO
    UserRepo -->|"Maps"| UserORM
    UserRepo -->|"Returns"| UserDTO

    Session -->|"asyncpg"| PG
    Session -->|"aiosqlite"| SQLite
    BaseRepo -->|"Uses"| Session

    CacheMgr -->|"aioredis"| Redis
    StorageClient -->|"boto3"| S3

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef db      fill:#172554,stroke:#1d4ed8,color:#bfdbfe
    classDef orm     fill:#0c2a4a,stroke:#2563eb,color:#93c5fd
    classDef repo    fill:#1e3a5f,stroke:#3b82f6,color:#bfdbfe
    classDef dto     fill:#0f2942,stroke:#0ea5e9,color:#bae6fd
    classDef cache   fill:#1a2e1a,stroke:#16a34a,color:#bbf7d0
    classDef storage fill:#2d1b4e,stroke:#9333ea,color:#e9d5ff
    classDef ext     fill:#0f172a,stroke:#475569,color:#94a3b8,stroke-dasharray:6 3

    class Base,Session db
    class BaseORM,UserORM,RoomORM,MsgORM,AttORM,UploadORM,DMORM orm
    class BaseRepo,MsgRepo,AttRepo,RoomRepo,UserRepo repo
    class MsgDTO,AttDTO,RoomDTO,UserDTO dto
    class CacheMgr cache
    class StorageClient storage
    class PG,SQLite,Redis,S3 ext
