    classDef schema  fill:#1c3a4a,stroke:#0ea5e9,color:#bae6fd
    classDef cross   fill:#1c1917,stroke:#78716c,color:#d6d3d1

    class Router,AuthRouter,MsgRouter,RoomRouter,AttRouter,PresRouter router
    class AuthDep,DBDep,RepoDep,SvcDep,ContDep dep
