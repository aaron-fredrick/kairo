flowchart TB
    %% ── C4 Level 4: Code – API Layer ─────────────────────────────────────
    %% Files: app/api/router.py, app/api/routers/*, app/api/dependencies/*,
    %%        app/api/exceptions.py, app/schemas/*

    subgraph APILayer["API Layer  [app/api/]"]
        direction TB

        Router["router.py<br/>api_router = APIRouter(prefix='/api')<br/>Mounts all sub-routers"]

        subgraph Routers["app/api/routers/"]
            AuthRouter["auth_router.py<br/>POST /auth/login<br/>POST /auth/register<br/>GET  /auth/me<br/>POST /auth/join"]
            MsgRouter["messages_router.py<br/>GET  /messages/{id}"]
            RoomRouter["rooms_router.py<br/>GET    /rooms<br/>POST   /rooms<br/>GET    /rooms/{id}<br/>GET    /rooms/{id}/join<br/>GET    /rooms/{id}/leave<br/>POST   /rooms/{id}/add_user<br/>GET    /rooms/{id}/messages"]
            AttRouter["attachments_router.py<br/>POST /attachments/upload/{msg_id}<br/>GET  /attachments/download/{id}<br/>GET  /attachments/{id}/thumbnail/{size}<br/>GET  /attachments/{id}"]
            PresRouter["presence_router.py<br/>POST /presence/heartbeat<br/>GET  /presence/online"]
        end

        subgraph Deps["app/api/dependencies/"]
            AuthDep["auth.py<br/>get_current_user_id()<br/>Decodes JWT Bearer token"]
            DBDep["db.py<br/>get_db_session()<br/>Yields AsyncSession per request"]
            RepoDep["repositories.py<br/>get_message_repo()<br/>get_attachment_repo()<br/>get_room_repo()<br/>get_user_repo()"]
            SvcDep["services.py<br/>get_message_service()<br/>get_attachment_service()<br/>get_presence_service()"]
            ContDep["container.py<br/>get_container()<br/>Reads app.state.container"]
        end

        subgraph Schemas["app/schemas/"]
            MsgSchema["message_schema.py<br/>MessageCreateSchema<br/>MessageResponseSchema<br/>MessageWithAttachmentsResponseSchema"]
            AttSchema["attachment_schema.py<br/>AttachmentResponseSchema<br/>UploadResponseSchema<br/>DownloadUrlResponseSchema<br/>ThumbnailResponseSchema<br/>ThumbnailSize"]
            AuthSchema["auth_schema.py<br/>TokenSchema<br/>UserRegisterSchema<br/>UserLoginSchema<br/>UserResponseSchema"]
            RoomSchema["room_schema.py<br/>RoomCreateSchema<br/>RoomResponseSchema"]
            PresSchema["presence_schema.py<br/>PresenceUpdateResponseSchema<br/>OnlineUsersResponseSchema"]
            CommonSchema["common_schema.py<br/>Shared base schema types"]
        end

        Exceptions["exceptions.py<br/>Register HTTP exception handlers:<br/>404 Not Found<br/>422 Unprocessable Entity<br/>500 Internal Server Error"]
        Health["app/health.py<br/>GET /health<br/>HealthCheckResponse<br/>{status, version, services}"]
    end

    %% ── Dependency chain ─────────────────────────────────────────────────
    Router --> AuthRouter & MsgRouter & RoomRouter & AttRouter & PresRouter

    AuthRouter --> AuthDep & AuthSchema
    MsgRouter  --> AuthDep & SvcDep & MsgSchema
    RoomRouter --> AuthDep & SvcDep & RoomSchema
    AttRouter  --> AuthDep & AttSchema
    PresRouter --> AuthDep & SvcDep & PresSchema

    RepoDep --> DBDep
    SvcDep  --> RepoDep & ContDep

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef router  fill:#14532d,stroke:#16a34a,color:#bbf7d0
    classDef dep     fill:#1e1b4b,stroke:#7c3aed,color:#ddd6fe
    classDef schema  fill:#1c3a4a,stroke:#0ea5e9,color:#bae6fd
    classDef cross   fill:#1c1917,stroke:#78716c,color:#d6d3d1

    class Router,AuthRouter,MsgRouter,RoomRouter,AttRouter,PresRouter router
    class AuthDep,DBDep,RepoDep,SvcDep,ContDep dep
    class MsgSchema,AttSchema,AuthSchema,RoomSchema,PresSchema,CommonSchema schema
    class Exceptions,Health cross
