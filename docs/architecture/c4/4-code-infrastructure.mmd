flowchart TB
    %% ── C4 Level 4: Code – Infrastructure Layer ──────────────────────────
    %% Files: app/infrastructure/db/*, app/infrastructure/repositories/*,
    %%        app/infrastructure/dtos/*, app/infrastructure/cache/*,
    %%        app/infrastructure/storage/*

    subgraph InfraLayer["Infrastructure Layer  [app/infrastructure/]"]
        direction TB

        subgraph DB["app/infrastructure/db/"]
            Base["base.py<br/>Base = declarative_base()<br/>Shared SQLAlchemy metadata"]
            Session["session.py<br/>engine: AsyncEngine<br/>SessionFactory: async_sessionmaker<br/>check_db_connection() → None<br/>Dialect-aware: sqlite or asyncpg"]

            subgraph ORM["app/infrastructure/db/orm/"]
                BaseORM["base_orm.py<br/>TimestampMixin<br/>created_at: DateTime<br/>updated_at: DateTime"]
                UserORM["user_orm.py<br/>UserORM<br/>id, username, hashed_password,<br/>role: UserRole, is_superadmin"]
                RoomORM["room_orm.py<br/>RoomORM<br/>id, name, created_by_id"]
                MsgORM["message_orm.py<br/>MessageORM<br/>id, content, sender_id, room_id<br/>→ attachments: AttachmentORM"]
                AttORM["attachment_orm.py<br/>AttachmentORM<br/>id, message_id, upload_id, filename"]
                UploadORM["upload_orm.py<br/>UploadORM<br/>id, filename, s3_key,<br/>content_type, size_bytes"]
                DMORM["direct_message_orm.py<br/>DirectMessageORM<br/>id, sender_id, receiver_id, content"]
            end
        end

        subgraph RepoLayer["app/infrastructure/repositories/"]
            BaseRepo["base_repository.py<br/>BaseRepository[ORM, DTO]<br/>─────────────────────────<br/>get_by_id(id) → DTO | None<br/>get_all() → list[DTO]<br/>create(data) → DTO<br/>update(id, data) → DTO | None<br/>delete(id) → bool<br/>_to_dto() [abstract]"]
            MsgRepo["message_repository.py<br/>MessageRepository<br/>_to_dto() → MessageDTO<br/>get_with_attachments(id) → MessageDTO | None"]
            AttRepo["attachment_repository.py<br/>AttachmentRepository<br/>_to_dto() → AttachmentDTO<br/>get_by_message_id(id) → list[AttachmentDTO]"]
            RoomRepo["room_repository.py<br/>RoomRepository<br/>_to_dto() → RoomDTO"]
            UserRepo["user_repository.py<br/>UserRepository<br/>_to_dto() → UserDTO<br/>get_by_username(username) → UserDTO | None"]
        end

        subgraph DTOLayer["app/infrastructure/dtos/"]
            MsgDTO["message_dto.py<br/>MessageDTO<br/>id, content, sender_id,<br/>room_id, created_at, updated_at"]
            AttDTO["attachment_dto.py<br/>AttachmentDTO<br/>id, message_id, upload_id,<br/>filename, created_at, updated_at"]
            RoomDTO["room_dto.py<br/>RoomDTO<br/>id, name, created_at"]
            UserDTO["user_dto.py<br/>UserDTO<br/>id, username, role, created_at"]
        end

        subgraph CacheLayer["app/infrastructure/cache/"]
            CacheMgr["CacheManager<br/>get(key) → str | None<br/>set(key, value, ttl) → None<br/>delete(key) → None<br/>keys(pattern) → list[str]"]
        end

        subgraph StorageLayer["app/infrastructure/storage/"]
            StorageClient["storage_client.py<br/>get_boto_client() → boto3.client | None<br/>check_storage_connection() → None<br/>generate_presigned_url(key, expiry) → str"]
        end
    end

    %% ── External Systems ──────────────────────────────────────────────────
    PG[("PostgreSQL<br/>asyncpg driver")]
    SQLite[("SQLite<br/>aiosqlite driver")]
    Redis[("Redis<br/>aioredis")]
    S3[("S3 / MinIO<br/>boto3")]

    %% ── Flows ─────────────────────────────────────────────────────────────
    BaseORM --> Base

    UserORM & RoomORM & MsgORM & AttORM & UploadORM & DMORM --> BaseORM

    MsgRepo & AttRepo & RoomRepo & UserRepo --> BaseRepo
    MsgRepo -->|"Maps"| MsgORM
    MsgRepo -->|"Returns"| MsgDTO
    AttRepo -->|"Maps"| AttORM
    AttRepo -->|"Returns"| AttDTO
    RoomRepo -->|"Maps"| RoomORM
    RoomRepo -->|"Returns"| RoomDTO
    UserRepo -->|"Maps"| UserORM
    UserRepo -->|"Returns"| UserDTO

    Session -->|"asyncpg"| PG
    Session -->|"aiosqlite"| SQLite
    BaseRepo -->|"Uses"| Session

    CacheMgr -->|"aioredis"| Redis
    StorageClient -->|"boto3"| S3

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef db      fill:#172554,stroke:#1d4ed8,color:#bfdbfe
    classDef orm     fill:#0c2a4a,stroke:#2563eb,color:#93c5fd
    classDef repo    fill:#1e3a5f,stroke:#3b82f6,color:#bfdbfe
    classDef dto     fill:#0f2942,stroke:#0ea5e9,color:#bae6fd
    classDef cache   fill:#1a2e1a,stroke:#16a34a,color:#bbf7d0
    classDef storage fill:#2d1b4e,stroke:#9333ea,color:#e9d5ff
    classDef ext     fill:#0f172a,stroke:#475569,color:#94a3b8,stroke-dasharray:6 3

    class Base,Session db
    class BaseORM,UserORM,RoomORM,MsgORM,AttORM,UploadORM,DMORM orm
    class BaseRepo,MsgRepo,AttRepo,RoomRepo,UserRepo repo
    class MsgDTO,AttDTO,RoomDTO,UserDTO dto
    class CacheMgr cache
    class StorageClient storage
    class PG,SQLite,Redis,S3 ext
