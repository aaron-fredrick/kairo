flowchart TB
    %% ── External Actors ──────────────────────────────────────────────────
    ClientApp["Client Application<br/>[Web / Mobile]"]
    LB["Load Balancer / Reverse Proxy<br/>[nginx / Caddy]"]

    %% ── Kairo API System Boundary ────────────────────────────────────────
    subgraph KairoAPI["Kairo API  [FastAPI Application]"]
        direction TB

        subgraph API["API Layer"]
            direction LR
            Routers["Routers<br/>[FastAPI APIRouter]<br/>auth, messages, rooms,<br/>presence, attachments"]
            Deps["Dependency Injection<br/>[FastAPI Depends]<br/>auth, db, repos, services"]
            Schemas["Request/Response Schemas<br/>[Pydantic]<br/>*Schema classes"]
            Health["Health Endpoint<br/>[GET /health]"]
        end

        subgraph App["Application Layer"]
            direction LR
            MsgSvc["MessageService<br/>[Python class]<br/>Orchestrates message CRUD<br/>and policy enforcement"]
            AttSvc["AttachmentService<br/>[Python class]<br/>Orchestrates attachment retrieval"]
            PresSvc["PresenceService<br/>[Python class]<br/>Heartbeat and online-user tracking"]
        end

        subgraph Domain["Domain Layer"]
            direction LR
            Models["Domain Models<br/>[Python dataclasses]<br/>MessageDomain, UserDomain,<br/>RoomDomain, AttachmentDomain"]
            Policies["Domain Policies<br/>[Pure Python]<br/>MessagePolicy"]
        end

        subgraph Infra["Infrastructure Layer"]
            direction LR
            Repos["Repositories<br/>[SQLAlchemy async]<br/>Message, Attachment,<br/>Room, User"]
            ORM["ORM Models<br/>[SQLAlchemy mapped]<br/>MessageORM, UserORM,<br/>RoomORM, AttachmentORM,<br/>UploadORM, DirectMessageORM"]
            DTOs["DTOs<br/>[Python dataclasses]<br/>MessageDTO, AttachmentDTO,<br/>RoomDTO, UserDTO"]
            CacheInfra["Cache Manager<br/>[Redis]<br/>Presence and session cache"]
            StorageInfra["Storage Client<br/>[S3 / MinIO]<br/>File upload and presigned URLs"]
        end

        Observability["Observability<br/>[structlog + OpenTelemetry]<br/>Request tracing, metrics,<br/>structured JSON logging"]
        Container["AppContainer<br/>[Composition Root]<br/>Wires Redis, Cache, Events<br/>at application startup"]
    end

    %% ── External Systems ─────────────────────────────────────────────────
    PostgreSQL[("PostgreSQL<br/>[Relational DB]")]
    Redis[("Redis<br/>[Cache / Pub-Sub]")]
    S3[("S3 / MinIO<br/>[Object Storage]")]

    %% ── Flows ────────────────────────────────────────────────────────────
    ClientApp -->|"HTTPS"| LB
    LB -->|"HTTP/1.1 or HTTP/2"| Routers
    LB -->|"HTTP GET /health"| Health

    Routers -->|"Resolves via"| Deps
    Routers -->|"Validates with"| Schemas
    Deps -->|"Injects"| MsgSvc
    Deps -->|"Injects"| AttSvc
    Deps -->|"Injects"| PresSvc

    MsgSvc -->|"Applies"| Policies
    MsgSvc -->|"Returns"| Models
    AttSvc -->|"Returns"| Models
    PresSvc -->|"Reads/Writes"| CacheInfra

    MsgSvc -->|"Calls"| Repos
    AttSvc -->|"Calls"| Repos

    Repos -->|"Maps ORM → DTO"| DTOs
    Repos -->|"Queries"| ORM
    ORM -->|"asyncpg driver"| PostgreSQL

    CacheInfra -->|"aioredis"| Redis
    StorageInfra -->|"boto3"| S3

    Container -->|"Initialises"| CacheInfra
    Container -->|"Initialises"| StorageInfra

    Routers -.->|"Emits spans/logs"| Observability

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef layer       fill:#1e293b,stroke:#334155,color:#f1f5f9
    classDef external    fill:#0f172a,stroke:#475569,color:#94a3b8,stroke-dasharray:6 3
    classDef infrasys    fill:#172554,stroke:#1d4ed8,color:#bfdbfe
    classDef apilayer    fill:#14532d,stroke:#16a34a,color:#bbf7d0
    classDef applayer    fill:#1e1b4b,stroke:#7c3aed,color:#ddd6fe
    classDef domlayer    fill:#451a03,stroke:#c2410c,color:#fed7aa
    classDef cross       fill:#1c1917,stroke:#78716c,color:#d6d3d1

    class API,Routers,Deps,Schemas,Health apilayer
    class App,MsgSvc,AttSvc,PresSvc applayer
    class Domain,Models,Policies domlayer
    class Infra,Repos,ORM,DTOs,CacheInfra,StorageInfra infrasys
    class Observability,Container cross
    class ClientApp,LB,PostgreSQL,Redis,S3 external
