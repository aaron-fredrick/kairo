  "theme": "dark",
  "sequence": {
    "actorMargin": 60,
    "messageMargin": 30,
    "mirrorActors": false,
    "noteMargin": 12,
    "boxTextMargin": 6
  }
}}%%

sequenceDiagram
    %% ── Participants ──────────────────────────────────────────────────────────
    actor       Client      as Client
    participant Router      as AuthRouter<br/>[POST /auth/refresh]
    participant AuthDep     as get_auth_service<br/>[Depends]
    participant AuthSvc     as AuthService
    participant JoseLib     as python-jose<br/>[jwt.decode]
    participant Cache       as CacheManager<br/>[Redis]
    participant Security    as security module<br/>[create_*_token]

    %% ── Flow ──────────────────────────────────────────────────────────────────
    Client->>Router: POST /auth/refresh<br/>{ refresh_token }

    Router->>AuthDep: resolve AuthService
    AuthDep-->>Router: AuthService instance

    Router->>AuthSvc: refresh_session(refresh_token)

    AuthSvc->>JoseLib: jwt.decode(token, secret, algorithms)
    JoseLib-->>AuthSvc: payload { sub, type, exp }

    alt JWTError (expired / tampered)
        AuthSvc-->>Router: raises ValueError("Invalid or expired refresh token")
        Router-->>Client: 401 Unauthorized
    end

    alt payload missing sub  OR  type ≠ "refresh"
        AuthSvc-->>Router: raises ValueError("Invalid refresh token")
        Router-->>Client: 401 Unauthorized
    end

    Note over AuthSvc: user_id = int(payload["sub"])

    alt user_id < 0  (anonymous user)
        AuthSvc->>Cache: GET "anon_user:{user_id}"
        Cache-->>AuthSvc: user_data JSON | None

        alt cache miss (session expired)
            AuthSvc-->>Router: raises ValueError("Session expired")
            Router-->>Client: 401 Unauthorized
        end

        Note over AuthSvc: Extend TTL — keep session alive

        AuthSvc->>Cache: SET "anon_user:{user_id}" = user_data  TTL=refresh_ttl
        Cache-->>AuthSvc: OK

        AuthSvc->>Cache: SET "username_taken:{username}" = "1"  TTL=refresh_ttl
        Cache-->>AuthSvc: OK

    else user_id >= 0  (registered user)
        AuthSvc->>Cache: GET "user:{user_id}"
        Cache-->>AuthSvc: user_data JSON | None

        alt cache miss (session expired)
            AuthSvc-->>Router: raises ValueError("Session expired")
            Router-->>Client: 401 Unauthorized
        end

        AuthSvc->>Cache: SET "user:{user_id}" = user_data  TTL=refresh_ttl
        Cache-->>AuthSvc: OK

        AuthSvc->>Cache: SET "user_by_username:{username}" = user_id  TTL=refresh_ttl
        Cache-->>AuthSvc: OK
    end

    Note over AuthSvc: Mint new token pair

    AuthSvc->>Security: create_access_token(sub=user_id)
    Security-->>AuthSvc: new_access_token (JWT)

    AuthSvc->>Security: create_refresh_token(sub=user_id)
    Security-->>AuthSvc: new_refresh_token (JWT)

    AuthSvc-->>Router: (new_access_token, new_refresh_token)

    Router-->>Client: 200 OK<br/>{ access_token, refresh_token, token_type }
