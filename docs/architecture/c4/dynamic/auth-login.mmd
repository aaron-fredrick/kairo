sequenceDiagram
    %% ── Participants ──────────────────────────────────────────────────────────
    actor       Client      as Client
    participant Router      as AuthRouter<br/>[POST /auth/login]
    participant AuthDep     as get_auth_service<br/>[Depends]
    participant AuthSvc     as AuthService
    participant UserRepo    as UserRepository<br/>[PostgreSQL]
    participant Security    as security module<br/>[verify_password / create_*_token]
    participant Cache       as CacheManager<br/>[Redis]

    %% ── Flow ──────────────────────────────────────────────────────────────────
    Client->>Router: POST /auth/login<br/>{ username, password }

    Router->>AuthDep: resolve AuthService
    AuthDep-->>Router: AuthService instance

    Router->>AuthSvc: login(username, password)

    AuthSvc->>UserRepo: get_by_username(username)
    UserRepo-->>AuthSvc: UserDTO | None

    alt user not found
        AuthSvc-->>Router: raises ValueError("Invalid credentials")
        Router-->>Client: 401 Unauthorized
    end

    AuthSvc->>Security: verify_password(password, hashed_password)
    Security-->>AuthSvc: bool

    alt password mismatch
        AuthSvc-->>Router: raises ValueError("Invalid credentials")
        Router-->>Client: 401 Unauthorized
    end

    Note over AuthSvc: Map UserDTO → user_data dict<br/>Cache hydration for get_me / session logic

    AuthSvc->>Cache: SET "user:{user_id}" = user_data  TTL=refresh_ttl
    Cache-->>AuthSvc: OK

    AuthSvc->>Cache: SET "user_by_username:{username}" = user_id  TTL=refresh_ttl
    Cache-->>AuthSvc: OK

    AuthSvc->>Security: create_access_token(sub=user_id)
    Security-->>AuthSvc: access_token (JWT)

    AuthSvc->>Security: create_refresh_token(sub=user_id)
    Security-->>AuthSvc: refresh_token (JWT)

    AuthSvc-->>Router: (UserDomain, access_token, refresh_token)

    Router-->>Client: 200 OK<br/>{ user, token: { access_token, refresh_token, token_type } }
