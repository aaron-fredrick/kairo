%%{init: {
  "theme": "dark",
  "flowchart": {
    "nodeSpacing": 45,
    "rankSpacing": 55
  }
}}%%

flowchart TB
    %% ── C4 Level 3 – Development variant ─────────────────────────────────
    %% Differences from production:
    %%   - SQLite replaces PostgreSQL
    %%   - Redis is optional (cache falls back to no-op)
    %%   - Storage is local filesystem under data/
    %%   - No load balancer; Uvicorn served directly with --reload

    ClientApp["Browser / API Client<br/>[localhost:5173 or curl]"]
    Uvicorn["Uvicorn Dev Server<br/>uv run uvicorn app.main:app --reload<br/>[127.0.0.1:8000]"]

    subgraph KairoAPI["Kairo API  [FastAPI Application] – dev"]
        direction TB

        subgraph API["API Layer"]
            direction LR
            Routers["Routers<br/>auth, messages, rooms,<br/>presence, attachments"]
            Deps["Dependency Injection<br/>auth, db, repos, services"]
            Schemas["Request/Response Schemas<br/>*Schema classes"]
            Health["GET /health"]
        end

        subgraph App["Application Layer"]
            direction LR
            MsgSvc["MessageService"]
            AttSvc["AttachmentService"]
            PresSvc["PresenceService"]
        end

        subgraph Domain["Domain Layer"]
            direction LR
            Models["Domain Models<br/>MessageDomain, UserDomain,<br/>RoomDomain, AttachmentDomain"]
            Policies["Policies<br/>MessagePolicy"]
        end

        subgraph Infra["Infrastructure Layer"]
            direction LR
            Repos["Repositories<br/>Message, Attachment, Room, User"]
            ORM["ORM Models<br/>SQLAlchemy mapped classes"]
            DTOs["DTOs<br/>Repository output boundary"]
            CacheInfra["Cache Manager<br/>[optional – Redis or no-op]"]
            StorageInfra["Local Storage Client<br/>[data/blobs/ on disk]"]
        end

        Observability["Observability<br/>structlog console output<br/>(no OTLP exporter in dev)"]
        Container["AppContainer<br/>Composition Root"]
    end

    %% ── Dev-specific external systems ─────────────────────────────────────
    SQLite[("SQLite<br/>kairo.db<br/>[aiosqlite – file on disk]")]
    Redis_dev[("Redis<br/>[optional, can be absent]")]
    LocalFS[("Local Filesystem<br/>data/blobs/<br/>data/temp/")]

    %% ── Flows ─────────────────────────────────────────────────────────────
    ClientApp -->|"HTTP (no TLS)"| Uvicorn
    Uvicorn --> Routers
    Uvicorn -->|"GET /health"| Health

    Routers -->|"Resolves via"| Deps
    Routers -->|"Validates with"| Schemas
    Deps -->|"Injects"| MsgSvc & AttSvc & PresSvc

    MsgSvc -->|"Applies"| Policies
    MsgSvc -->|"Returns"| Models
    AttSvc -->|"Returns"| Models
    PresSvc -->|"Reads/Writes"| CacheInfra

    MsgSvc & AttSvc -->|"Calls"| Repos
    Repos -->|"Maps ORM → DTO"| DTOs
    Repos -->|"Queries"| ORM
    ORM -->|"aiosqlite"| SQLite

    CacheInfra -.->|"optional aioredis"| Redis_dev
    StorageInfra -->|"os.makedirs / file I/O"| LocalFS

    Container -->|"Initialises"| CacheInfra & StorageInfra
    Routers -.->|"Console logs"| Observability

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef apilayer  fill:#14532d,stroke:#16a34a,color:#bbf7d0
    classDef applayer  fill:#1e1b4b,stroke:#7c3aed,color:#ddd6fe
    classDef domlayer  fill:#451a03,stroke:#c2410c,color:#fed7aa
    classDef infralayer fill:#172554,stroke:#1d4ed8,color:#bfdbfe
    classDef external  fill:#0f172a,stroke:#475569,color:#94a3b8,stroke-dasharray:6 3
    classDef cross     fill:#1c1917,stroke:#78716c,color:#d6d3d1

    class API,Routers,Deps,Schemas,Health apilayer
    class App,MsgSvc,AttSvc,PresSvc applayer
    class Domain,Models,Policies domlayer
    class Infra,Repos,ORM,DTOs,CacheInfra,StorageInfra infralayer
    class Observability,Container cross
    class ClientApp,Uvicorn,SQLite,Redis_dev,LocalFS external
