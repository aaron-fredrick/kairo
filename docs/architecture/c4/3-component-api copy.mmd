flowchart TD

    subgraph API[API Service]

        %% Base
        Router["API Router (FastAPI)"]

        subgraph AuthModule[Authentication Module]
            direction TB
            AuthRoute[Auth Route]
            AuthService["Auth Service"]
            AuthRepo["Auth Repository"]
        end

        subgraph RoomModule[Room Management Module]
            direction TB
            RoomRoute[Room Route]
            RoomService["Room Service"]
            RoomRepo["Room Repository"]
        end

        subgraph MessageModule[Messaging Module]
            direction TB
            MessageRoute[Message Route]
            MessageService["Message Service"]
            MessageRepo["Message Repository"]
        end

        subgraph AttachmentModule[Attachment Module]
            direction TB
            AttachmentRoute[Attachment Route]
            AttachmentService["Attachment Service"]
            AttachmentRepo["Attachment Repository"]
        end

        subgraph PresenceModule[Presence Module]
            direction TB
            PresenceRoute[Presence Route]
            PresenceService["Presence Service"]
            PresenceRepo["Presence Repository"]
        end
        
        UserRepo["User Repository"]

        %% DB
        DBEngine["Database Engine (SQLAlchemy)"]

        %% Core
        Security["Security (JWT, OAuth)"]

        RedisClient["Redis Client (redis-py)"]
        StorageClient["Storage Client (boto3)"]

        %% platform
        Logging[Logging System]
        Metrics[Prometheus Metrics Client]
        Tracing[Tracing Instrumentation]

        Health[Health Check Endpoint]

    end

    subgraph CP[Control Plane]
        Prometheus[(Prometheus)]
        Loki[(Loki)]
        Tempo[(Tempo)]
    end

    Postgres[(PostgreSQL)]
    Redis[(Redis)]
    Storage[(Object Storage - S3/MinIO)]

    

