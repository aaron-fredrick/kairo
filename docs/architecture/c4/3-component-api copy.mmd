    PresenceRoute --> PresenceService

    AuthService --> Security

    AuthService --> AuthRepo
    RoomService --> RoomRepo
    MessageService --> MessageRepo
    AttachmentService --> AttachmentRepo
    PresenceService --> PresenceRepo

    AttachmentService --> StorageClient
    AttachmentService --> RedisClient

    AuthRepo --> DBEngine
    RoomRepo --> DBEngine
    MessageRepo --> DBEngine
    AttachmentRepo --> DBEngine
    PresenceRepo --> DBEngine

    DBEngine --> Postgres

    RedisClient --> Redis

    StorageClient --> Storage

    Router --> Health

    Logging --> Loki
    Metrics --> Prometheus
