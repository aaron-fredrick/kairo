flowchart TB
    %% ── C4 Level 4: Code – Observability + Container (Cross-cutting) ─────
    %% Files: app/observability/*, app/container.py, app/core/*

    subgraph CrossCutting["Cross-cutting Concerns"]
        direction TB

        subgraph Obs["app/observability/"]
            ObsInit["__init__.py<br/>setup(app) → None<br/>Calls: setup_logging()<br/>       setup_tracing()<br/>       setup_metrics()"]

            Logging["logging.py<br/>setup_logging()<br/>Configures structlog:<br/>  - JSON renderer<br/>  - ISO timestamps<br/>  - Log level filter<br/>  - OpenTelemetry log handler"]

            Tracing["tracing.py<br/>setup_tracing()<br/>OpenTelemetry TracerProvider<br/>OTLP gRPC exporter"]

            Metrics["metrics.py<br/>setup_metrics()<br/>OpenTelemetry MeterProvider<br/>Prometheus / OTLP exporter"]

            OTel["otel.py<br/>OTLP exporter configuration<br/>Resource attributes:<br/>  service.name = kairo-api<br/>  deployment.environment"]

            subgraph Middleware["app/observability/middleware/"]
                ReqIDMw["request_id_middleware.py<br/>request_id_middleware()<br/>Generates X-Request-ID if absent<br/>Binds to structlog contextvars<br/>Propagates header in response"]
                MetricsMw["metrics_middleware.py<br/>metrics_middleware()<br/>Records HTTP request duration<br/>and status code counters"]
            end
        end

        subgraph CoreLayer["app/core/"]
            Config["config.py<br/>Settings (pydantic-settings)<br/>─────────────────────────────<br/>ENV, DEBUG<br/>DATABASE_URL property<br/>  sqlite (dev) | asyncpg (prod)<br/>REDIS_URL<br/>STORAGE_BACKEND, S3_*<br/>JWT_SECRET, JWT_ALGORITHM<br/>ADJECTIVES_FILE, NOUNS_FILE<br/>cors_origins_list property<br/>validate_production()"]

            Security["security.py<br/>verify_password(plain, hashed) → bool<br/>get_password_hash(password) → str<br/>create_access_token(subject, delta) → str<br/>─────────────────────────────<br/>Passlib bcrypt + python-jose"]
        end

        Container["app/container.py<br/>AppContainer<br/>─────────────────────────────<br/>redis: Redis client<br/>cache_manager: CacheManager<br/>event_manager: EventManager<br/>─────────────────────────────<br/>close() → None<br/>Called by lifespan on shutdown"]

        Main["app/main.py<br/>FastAPI application factory<br/>─────────────────────────────<br/>lifespan():<br/>  check_db_connection()<br/>  check_storage_connection()<br/>  AppContainer() → app.state.container<br/>Middleware chain:<br/>  request_id → metrics → CORS<br/>exception_handler(Exception)"]
    end

    %% ── External Observability Backend ───────────────────────────────────
    OTEL[("OpenTelemetry Collector<br/>[OTLP gRPC / HTTP]")]
    Prometheus[("Prometheus / Grafana<br/>[Metrics scrape]")]

    %% ── Flows ─────────────────────────────────────────────────────────────
    Main -->|"Calls at startup"| ObsInit
    Main -->|"Initialises"| Container
    Main -->|"Registers"| ReqIDMw & MetricsMw

    ObsInit --> Logging & Tracing & Metrics
    Tracing --> OTel
    Metrics --> OTel
    OTel -->|"OTLP"| OTEL
    Metrics -.->|"Scrape"| Prometheus

    Container -->|"Reads"| Config
    Security -->|"Reads"| Config

    %% ── Styles ───────────────────────────────────────────────────────────
    classDef obs     fill:#1e293b,stroke:#475569,color:#cbd5e1
    classDef mw      fill:#172554,stroke:#1d4ed8,color:#bfdbfe
    classDef core    fill:#1c1917,stroke:#78716c,color:#d6d3d1
    classDef cont    fill:#14532d,stroke:#16a34a,color:#bbf7d0
    classDef ext     fill:#0f172a,stroke:#475569,color:#94a3b8,stroke-dasharray:6 3

    class ObsInit,Logging,Tracing,Metrics,OTel obs
    class ReqIDMw,MetricsMw mw
    class Config,Security core
    class Container,Main cont
    class OTEL,Prometheus ext
