# =============================================================================
# Kairo — Environment Configuration Template
# =============================================================================
# Copy this file to .env and adjust values for your local setup.
#
# SECRETS (JWT key, DB password, S3 keys…) do NOT go here.
# They live in secrets/*.txt — see secrets/*.txt.example for templates.
#
# Environment detection:
#   .env present  → ENV=development
#   .env absent   → production (ConfigResolver enforces secrets-only mode)
# =============================================================================

# Runtime environment
ENV=development
DEBUG=true

# API server
API_HOST=0.0.0.0
API_PORT=8000
SERVER_URL=http://localhost:8000
CORS_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# Observability
LOG_LEVEL=DEBUG
OTEL_ENABLED=false

# Database
# DB_BACKEND: sqlite | postgres
DB_BACKEND=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kairo
DB_USER=kairo
# DB password → secrets/db_password.txt
# Full DSN    → secrets/database_url.txt (overrides individual DB_* vars)

# Cache & Event Bus
# EVENT_BUS: local | redis
EVENT_BUS=redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Object storage
# STORAGE_BACKEND: local | minio | s3
STORAGE_BACKEND=minio
MINIO_ENDPOINT=http://127.0.0.1:7000
MINIO_BUCKET=kairo
MINIO_REGION=us-east-1
DATA_DIR=data
# S3/MinIO credentials → secrets/s3_access_key.txt & secrets/s3_secret_key.txt

# JWT
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080
# JWT signing secret → secrets/jwt_secret.txt

# CI — add CODECOV_TOKEN as a repository secret in GitHub Actions
# (Settings → Secrets → Actions). Do not put it here.
