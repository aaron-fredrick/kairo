[run]
source = src/backend, src/register
branch = True
omit =
    */tests/*
    */migrations/*
    src/backend/main.py
    src/backend/services/chat_service.py
    src/backend/services/presence_service.py
    src/backend/utils/__init__.py
    src/backend/storage/backends.py
    src/backend/db/redis.py

[report]
show_missing = True
skip_empty = True
precision = 2

[xml]
output = coverage.xml
